# Non-secret settings of the testnet API stack. 50-api.sh copies this to
# $API_HOME/compose.env and appends API_PUBLIC_IP, read on the node (this repo is public:
# no node address is written here). Secrets live only on the node, under $API_HOME.
API_NET=testnet
API_HOME=/opt/outlayer-testnet-api
API_PORT=31443
API_SUBNET_EDGE=172.30.10.0/24
API_SUBNET_DB=172.30.11.0/24
API_COORDINATOR_IP=172.30.10.10
PG_DB=offchainvm
# Size of the fixed data image (Postgres, Redis, wasm cache).
API_DATA_SIZE=50G
# Postgres: the image defaults, which testnet has always run with.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=128MB
