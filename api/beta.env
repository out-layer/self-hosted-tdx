# Non-secret settings of the beta API stack: testnet contracts, its own coordinator, Postgres
# and Redis (an empty demo database, never a copy of testnet's), served as
# beta-testnet-api.outlayer.ai. 50-api.sh copies this to $API_HOME/compose.env and appends
# API_PUBLIC_IP, read on the node. Secrets live only on the node, under $API_HOME.
API_NET=beta
API_HOME=/opt/outlayer-beta-api
API_PORT=31445
API_SUBNET_EDGE=172.30.14.0/24
API_SUBNET_DB=172.30.15.0/24
API_COORDINATOR_IP=172.30.14.10
PG_DB=offchainvm
# Size of the fixed data image (Postgres, Redis, wasm cache).
API_DATA_SIZE=20G
# Postgres: the image defaults.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=128MB
