# Non-secret settings of the mainnet API stack. 50-api.sh copies this to
# $API_HOME/compose.env and appends API_PUBLIC_IP, read on the node (this repo is public:
# no node address is written here). Secrets live only on the node, under $API_HOME.
API_NET=mainnet
API_HOME=/opt/outlayer-mainnet-api
API_PORT=31444
API_SUBNET_EDGE=172.30.12.0/24
API_SUBNET_DB=172.30.13.0/24
API_COORDINATOR_IP=172.30.12.10
PG_DB=outlayer
# Size of the fixed data image (Postgres, Redis, wasm cache).
API_DATA_SIZE=200G
# Postgres, as the mainnet instance on the old host runs today (DB_POOL_SIZE=200 needs more
# than the default 100 connections).
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=8GB
